# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# LLM Text & Planning Model (OpenAI, NVIDIA NIM, Groq, Together, Ollama, etc.)
AGENTIC_BROWSER_TEXT_MODEL=gpt-4o
AGENTIC_BROWSER_TEXT_API_KEY=your-api-key-here
AGENTIC_BROWSER_TEXT_BASE_URL=https://api.openai.com/v1

# Screenshot Analysis / Vision Model Configuration
AGENTIC_BROWSER_SS_ENABLED=true
AGENTIC_BROWSER_SS_MODEL=gpt-4o
AGENTIC_BROWSER_SS_API_KEY=your-api-key-here
AGENTIC_BROWSER_SS_BASE_URL=https://api.openai.com/v1

# Google Search Configuration (Optional: for Google Custom Search tool)
GOOGLE_API_KEY=
GOOGLE_CX=

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_STORAGE_DIR=./data/browser_storage
BROWSER_SLOW_MO=100
MAX_STEPS=15

# Database Configuration
DATABASE_PATH=./data/agentic_browser.db
